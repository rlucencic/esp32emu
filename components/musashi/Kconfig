menu "68000 core (Musashi)"

    choice M68K_CPU
        prompt "CPU"
        default M68K_68000
        help
            The machine's CPU, fixed at compile time. The project's
            sdkconfig.defaults sets it.

        config M68K_68000
            bool "68000 (Atari ST, compact Macintosh)"
        config M68K_68020
            bool "68020 (Macintosh LC and II)"
        config M68K_68030
            bool "68030 with its MMU (Macintosh LC II and LC III)"
    endchoice

endmenu
