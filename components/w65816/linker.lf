# The opcode switch's jump table (the core's only read-only data) in
# internal RAM: from flash, through a data cache that the video keeps
# flushing, the 6502's dispatch was a tenth of the emulation's time. The
# disassembler's tables (w65816_dis.c) stay in flash.
[mapping:w65816]
archive: libw65816.a
entries:
    w65816 (noflash_data)
